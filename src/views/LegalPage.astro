---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui } from '../i18n/ui';
import { site, withLang, type Lang } from '../data/site';
import Icon from '../components/Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const l = t.legal;
---

<BaseLayout lang={lang} title={t.meta.legal.title} description={t.meta.legal.description}>
  <div class="legal-page">
    <div class="container legal-container">
      <p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span>{l.eyebrow}</p>
      <h1>{l.title}</h1>
      <p class="legal-updated">{l.updated}</p>
      <p class="legal-intro">{l.intro}</p>

      <div class="legal-sections">
        {l.sections.map((section, index) => (
          <section class="legal-section" data-reveal style={`--delay:${index * 40}ms`}>
            <span class="legal-index">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h2>{section.title}</h2>
              <p>{section.body}</p>
            </div>
          </section>
        ))}
      </div>

      <div class="legal-footer">
        <a class="text-link" href={withLang(lang, '/contact/')}>
          {t.footer.contact}
          <Icon name="arrow-up-right" size={15} />
        </a>
        <a class="text-link" href={`mailto:${site.email}`}>
          {site.email}
          <Icon name="mail" size={15} />
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
