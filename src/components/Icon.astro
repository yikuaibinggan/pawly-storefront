---
type IconName =
  | 'paw'
  | 'arrow-up-right'
  | 'arrow-right'
  | 'arrow-down'
  | 'check'
  | 'chevron-down'
  | 'plus'
  | 'minus'
  | 'mail'
  | 'whatsapp'
  | 'instagram'
  | 'tiktok'
  | 'linkedin'
  | 'globe'
  | 'menu'
  | 'close'
  | 'sparkle'
  | 'leaf'
  | 'shield'
  | 'box'
  | 'heart'
  | 'quote'
  | 'search';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 20, strokeWidth = 1.7, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'paw' && (
    <>
      <ellipse cx="6.3" cy="9.2" rx="1.9" ry="2.8" transform="rotate(-22 6.3 9.2)" />
      <ellipse cx="10.1" cy="5.4" rx="1.9" ry="2.8" transform="rotate(-7 10.1 5.4)" />
      <ellipse cx="14.7" cy="5.6" rx="1.9" ry="2.8" transform="rotate(10 14.7 5.6)" />
      <ellipse cx="18.3" cy="9.6" rx="1.9" ry="2.8" transform="rotate(25 18.3 9.6)" />
      <path d="M12 11.2c-2.9 0-5.4 2.4-5.4 5.1 0 2 1.5 3.2 3.3 3.2 1 0 1.5-.4 2.1-.4s1.1.4 2.1.4c1.8 0 3.3-1.2 3.3-3.2 0-2.7-2.5-5.1-5.4-5.1Z" />
    </>
  )}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'arrow-right' && <path d="M4 12h16M14 6l6 6-6 6" />}
  {name === 'arrow-down' && <path d="M12 4v16M6 14l6 6 6-6" />}
  {name === 'check' && <path d="m4 12.5 5 4.5L20 6.5" />}
  {name === 'chevron-down' && <path d="m6 9 6 6 6-6" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'minus' && <path d="M5 12h14" />}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2.5" />
      <path d="m4 7 8 6 8-6" />
    </>
  )}
  {name === 'whatsapp' && (
    <>
      <path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3.5 20.5l1.4-4.2a8.5 8.5 0 1 1 15.6-4.7Z" />
      <path d="M8.2 7.7c.4-.1.8 0 1 .4l.7 1.5c.2.4.1.8-.2 1.1l-.6.6c.5 1.1 1.4 2 2.5 2.5l.6-.6c.3-.3.7-.4 1.1-.2l1.5.7c.4.2.5.6.4 1-.2.8-.9 1.4-1.8 1.4-3.3 0-6-2.7-6-6 0-.9.5-1.6 1.3-1.8Z" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r=".8" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'tiktok' && <path d="M14.2 3.5v10.2a4.2 4.2 0 1 1-3.6-4.1M14.2 5.2c.8 1.5 2.1 2.5 3.9 2.8" />}
  {name === 'linkedin' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="3.5" />
      <path d="M8 10v6M8 7.4v.1M11.5 16v-3.4a2.2 2.2 0 0 1 4.4 0V16M11.5 10v1" />
    </>
  )}
  {name === 'globe' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M3.8 12h16.4M12 3.5c2.1 2.2 3.2 5.1 3.2 8.5S14.1 18.3 12 20.5C9.9 18.3 8.8 15.4 8.8 12S9.9 5.7 12 3.5Z" />
    </>
  )}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18" />}
  {name === 'sparkle' && (
    <path d="M12 3.5c.7 4.4 2.1 5.8 6.5 6.5-4.4.7-5.8 2.1-6.5 6.5-.7-4.4-2.1-5.8-6.5-6.5 4.4-.7 5.8-2.1 6.5-6.5ZM18.5 15.5c.3 2 .9 2.6 2.9 2.9-2 .3-2.6.9-2.9 2.9-.3-2-.9-2.6-2.9-2.9 2-.3 2.6-.9 2.9-2.9Z" />
  )}
  {name === 'leaf' && (
    <>
      <path d="M20 4c-7.5-.4-13.2 2.2-14.8 7.1-1.2 3.7 1.2 7 4.8 7.3 4.5.4 8.8-4.3 10-14.4Z" />
      <path d="M4 21c1.8-6.2 5.6-9.5 11-11" />
    </>
  )}
  {name === 'shield' && (
    <>
      <path d="M12 3.2 19 6v5.4c0 4.3-2.8 7.7-7 9.4-4.2-1.7-7-5.1-7-9.4V6l7-2.8Z" />
      <path d="m8.8 11.8 2.2 2.2 4.3-4.4" />
    </>
  )}
  {name === 'box' && (
    <>
      <path d="m4 7.5 8-4 8 4-8 4-8-4Z" />
      <path d="M4 7.5V16l8 4 8-4V7.5M12 11.5V20" />
    </>
  )}
  {name === 'heart' && <path d="M20.2 5.8a5 5 0 0 0-7.1 0L12 6.9l-1.1-1.1a5 5 0 0 0-7.1 7.1L12 21l8.2-8.1a5 5 0 0 0 0-7.1Z" />}
  {name === 'quote' && <path d="M9.5 6C6.5 7.5 5 10 5 13.5V18h5v-5H7c0-2.4.8-4 2.5-5V6Zm9 0C15.5 7.5 14 10 14 13.5V18h5v-5h-3c0-2.4.8-4 2.5-5V6Z" />}
  {name === 'search' && (
    <>
      <circle cx="10.8" cy="10.8" r="6.3" />
      <path d="m16 16 4.2 4.2" />
    </>
  )}
</svg>
