---
import type { Lang } from '../data/site';
import { withLang } from '../data/site';

interface Props {
  lang: Lang;
  path: string;
  variant?: 'header' | 'footer' | 'mobile';
}

const { lang, path, variant = 'header' } = Astro.props;
const enHref = withLang('en', path);
const zhHref = withLang('zh', path);
---

<div class={`language-switch language-switch--${variant}`} aria-label={lang === 'zh' ? '切换语言' : 'Switch language'}>
  <a
    href={enHref}
    class:list={['language-option', { 'is-active': lang === 'en' }]}
    hreflang="en"
    lang="en"
    data-set-lang="en"
    aria-current={lang === 'en' ? 'true' : undefined}
  >
    EN
  </a>
  <span class="language-divider" aria-hidden="true">/</span>
  <a
    href={zhHref}
    class:list={['language-option', { 'is-active': lang === 'zh' }]}
    hreflang="zh"
    lang="zh"
    data-set-lang="zh"
    aria-current={lang === 'zh' ? 'true' : undefined}
  >
    中文
  </a>
</div>
